---
import EnquirySection from '../../components/EnquirySection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canonicalPages } from '../../lib/site-pages';
const metadata = canonicalPages.find((page) => page.path === '/contact/')!;
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.path}>
  <section class="contact-page">
    <div class="shell contact-intro">
      <h1>Send a flower enquiry</h1>
      <p>Need help choosing flowers, checking a detail, or sending an enquiry? Share the occasion, budget, delivery date, recipient preferences, delivery location, and anything else that would help clarify the request.</p>
    </div>
  </section>
  <EnquirySection />
</BaseLayout>
