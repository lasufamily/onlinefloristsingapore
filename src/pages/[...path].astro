---
import { getCollection } from 'astro:content';
import KnowledgePage from '../components/KnowledgePage.astro';
import affiliateLinks from '../data/affiliate-links.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { optimizeDescription, optimizeTitle } from '../lib/seo';

type AffiliateLink = {
  id: string;
  href: string;
  anchor: string;
  partner: string;
  disclosure: string;
  active: boolean;
};

export async function getStaticPaths() {
  const pages = await getCollection('knowledgePages');
  return pages.map((page) => ({
    params: { path: page.data.path.replace(/^\//, '').replace(/\/$/, '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const [allPages, faqs] = await Promise.all([
  getCollection('knowledgePages'),
  getCollection('faq'),
]);
const affiliate = page.data.affiliateLinkId
  ? (affiliateLinks as AffiliateLink[]).find((entry) => entry.id === page.data.affiliateLinkId && entry.active)
  : undefined;
const pageByPath = new Map(allPages.map((entry) => [entry.data.path, entry]));
const breadcrumbItems = [{ name: 'Home', item: 'https://onlinefloristsingapore.com/' }];
const ancestors = [];
let parentPath = page.data.parent;
while (parentPath && parentPath !== '/') {
  const parent = pageByPath.get(parentPath);
  if (!parent) break;
  ancestors.unshift(parent);
  parentPath = parent.data.parent;
}
for (const ancestor of ancestors) breadcrumbItems.push({ name: ancestor.data.heading, item: new URL(ancestor.data.path, Astro.site).toString() });
breadcrumbItems.push({ name: page.data.heading, item: new URL(page.data.path, Astro.site).toString() });
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({ '@type': 'ListItem', position: index + 1, ...item })),
};
---

<BaseLayout title={optimizeTitle(page.data.title, page.data.heading)} description={optimizeDescription(page.data.description, page.data.intro)} canonicalPath={page.data.path} image={page.data.image} structuredData={structuredData}>
  <KnowledgePage page={page} allPages={allPages} faqs={faqs} affiliate={affiliate} />
</BaseLayout>
