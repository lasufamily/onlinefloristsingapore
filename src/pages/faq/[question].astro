---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brand } from '../../lib/brand';
import { optimizeDescription, optimizeTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const faqs = await getCollection('faq');
  return faqs.map((faq) => ({ params: { question: faq.data.slug }, props: { faq } }));
}

const { faq } = Astro.props;
const title = optimizeTitle(`${faq.data.question} | ${brand.name}`, faq.data.question);
---

<BaseLayout title={title} description={optimizeDescription(faq.data.answer)} canonicalPath={`/faq/${faq.data.slug}/`}>
  <article class="faq-page shell">
    <h1>{faq.data.question}</h1>
    <p class="faq-answer">{faq.data.answer}</p>
  </article>
</BaseLayout>
