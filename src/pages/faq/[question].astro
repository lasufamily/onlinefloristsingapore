---
import { ArrowRight, ChevronRight, ExternalLink } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brand } from '../../lib/brand';

export async function getStaticPaths() {
  const faqs = await getCollection('faq');
  return faqs.map((faq) => ({ params: { question: faq.data.slug }, props: { faq } }));
}

const { faq } = Astro.props;
const pages = await getCollection('knowledgePages');
const byPath = new Map(pages.map((page) => [page.data.path, page]));
const related = faq.data.relatedPages.map((path) => byPath.get(path)).filter(Boolean);
const title = `${faq.data.question} | ${brand.name}`;
---

<BaseLayout title={title} description={faq.data.answer} canonicalPath={`/faq/${faq.data.slug}/`}>
  <nav class="breadcrumbs shell" aria-label="Breadcrumb">
    <a href="/">Home</a><ChevronRight size={14} aria-hidden="true" /><a href="/faq/">FAQ</a><ChevronRight size={14} aria-hidden="true" /><span aria-current="page">{faq.data.question}</span>
  </nav>
  <article class="faq-page shell">
    <p class="eyebrow">{faq.data.category}</p>
    <h1>{faq.data.question}</h1>
    <p class="faq-answer">{faq.data.answer}</p>

    {faq.data.sources.length > 0 && (
      <aside class="source-note" aria-label="Sources">
        <strong>Checked against</strong>
        {faq.data.sources.map((source) => <a href={source.url} rel="noopener noreferrer">{source.label}<ExternalLink size={15} aria-hidden="true" /></a>)}
      </aside>
    )}

    {related.length > 0 && (
      <div class="faq-next">
        <span>Read more on this topic</span>
        {related.map((entry) => entry && <a href={entry.data.path}>{entry.data.heading}<ArrowRight size={18} aria-hidden="true" /></a>)}
      </div>
    )}
  </article>
</BaseLayout>
