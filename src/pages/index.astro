---
import { ArrowRight, BookOpen, Flower2, Search, Sprout } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { canonicalPages } from '../lib/site-pages';

const pages = await getCollection('knowledgePages');
const faqs = (await getCollection('faq')).sort((a, b) => a.data.priority - b.data.priority);
const home = canonicalPages.find((page) => page.path === '/')!;
const topLevelPaths = ['/flowers/', '/occasions/', '/flowers-for/', '/bouquets-and-arrangements/', '/gifts/', '/plants/', '/guides/', '/flower-culture/'];
const topics = topLevelPaths.map((path) => pages.find((page) => page.data.path === path)).filter(Boolean);
---

<BaseLayout title={home.title} description={home.description} canonicalPath="/">
  <section class="hero knowledge-home-hero">
    <img src="/images/hero-flowers.jpg" alt="Fresh flowers being arranged on a florist's worktable" width="1920" height="1280" fetchpriority="high" />
    <div class="hero-content shell">
      <p class="eyebrow">Online Florist Singapore</p>
      <h1>Flowers for real Singapore occasions</h1>
      <p>Choose better flowers for birthdays, openings, condolence visits, proposals, office gifts, and the small “thinking of you” moments in between.</p>
      <div class="hero-actions">
        <a class="button light" href="/flowers/">Browse flowers <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="button hero-secondary" href="/faq/"><Search size={18} aria-hidden="true" /> Find quick answers</a>
      </div>
    </div>
  </section>

  <div class="trust-strip knowledge-principles" aria-label="Editorial principles">
    <div class="trust-item"><BookOpen size={23} aria-hidden="true" /><div><strong>Clear before clever</strong><span>Plain advice before you spend money.</span></div></div>
    <div class="trust-item"><Flower2 size={23} aria-hidden="true" /><div><strong>For actual gifting</strong><span>Match flowers to the person, place, and message.</span></div></div>
    <div class="trust-item"><Sprout size={23} aria-hidden="true" /><div><strong>Local sense-checks</strong><span>Heat, humidity, delivery timing, and customs all count.</span></div></div>
  </div>

  <section class="section" id="explore">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Explore</p><h2>Start with the choice in front of you</h2></div>
        <p>Pick the topic closest to what you are sending, then narrow down by flower, recipient, arrangement, or occasion.</p>
      </div>
      <div class="topic-grid">
        {topics.map((topic) => topic && (
          <a class="topic-card" href={topic.data.path}>
            <img src={topic.data.image} alt={topic.data.imageAlt} width="720" height="520" />
            <div><span>{topic.data.eyebrow}</span><h3>{topic.data.heading}</h3><p>{topic.data.description}</p><ArrowRight size={19} aria-hidden="true" /></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section popular-questions">
    <div class="shell two-column-heading">
      <div><p class="eyebrow">Popular questions</p><h2>Quick help before you order</h2><p>Simple answers for the things people usually search when they need flowers soon.</p></div>
      <div class="question-list">
        {faqs.slice(0, 6).map((faq) => <a href={`/faq/${faq.data.slug}/`}>{faq.data.question}<ArrowRight size={18} aria-hidden="true" /></a>)}
        <a class="all-questions" href="/faq/">See all questions <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="section editorial-band">
    <div class="shell editorial-layout">
      <div><p class="eyebrow">Buy with more confidence</p><h2>The nicest photo is not always the best choice</h2></div>
      <div><p>Freshness, scent, colour, pets, venue rules, delivery timing, and the card message can all change what feels right. A little checking saves you from sending flowers that look good online but feel off in real life.</p><a class="text-link" href="/guides/choosing-flowers/">Read the choosing guide <ArrowRight size={17} aria-hidden="true" /></a></div>
    </div>
  </section>
</BaseLayout>
