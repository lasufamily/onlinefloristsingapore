---
import { ArrowRight, BookOpen, Flower2, Search, Sprout } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { canonicalPages } from '../lib/site-pages';

const pages = await getCollection('knowledgePages');
const faqs = (await getCollection('faq')).sort((a, b) => a.data.priority - b.data.priority);
const home = canonicalPages.find((page) => page.path === '/')!;
const topLevelPaths = ['/flowers/', '/occasions/', '/flowers-for/', '/bouquets-and-arrangements/', '/gifts/', '/plants/', '/guides/', '/flower-culture/'];
const topics = topLevelPaths.map((path) => pages.find((page) => page.data.path === path)).filter(Boolean);
---

<BaseLayout title={home.title} description={home.description} canonicalPath="/">
  <section class="hero knowledge-home-hero">
    <img src="/images/hero-flowers.jpg" alt="Fresh flowers being arranged on a florist's worktable" width="1920" height="1280" fetchpriority="high" />
    <div class="hero-content shell">
      <p class="eyebrow">Online Florist Singapore</p>
      <h1>Flower knowledge for Singapore</h1>
      <p>Understand flower types, meanings, care, arrangements, recipients, and occasions before deciding what to buy.</p>
      <div class="hero-actions">
        <a class="button light" href="/flowers/">Explore flowers <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="button hero-secondary" href="/faq/"><Search size={18} aria-hidden="true" /> Browse questions</a>
      </div>
    </div>
  </section>

  <div class="trust-strip knowledge-principles" aria-label="Editorial principles">
    <div class="trust-item"><BookOpen size={23} aria-hidden="true" /><div><strong>Learn before buying</strong><span>Practical guidance comes before recommendations.</span></div></div>
    <div class="trust-item"><Flower2 size={23} aria-hidden="true" /><div><strong>Built around real choices</strong><span>Compare flowers by meaning, care, setting, and recipient.</span></div></div>
    <div class="trust-item"><Sprout size={23} aria-hidden="true" /><div><strong>Made for local conditions</strong><span>Singapore humidity, delivery, customs, and availability matter.</span></div></div>
  </div>

  <section class="section" id="explore">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Explore the library</p><h2>Start with what you need to understand</h2></div>
        <p>Move from broad topics into focused guides without losing your place in the bigger flower picture.</p>
      </div>
      <div class="topic-grid">
        {topics.map((topic) => topic && (
          <a class="topic-card" href={topic.data.path}>
            <img src={topic.data.image} alt={topic.data.imageAlt} width="720" height="520" />
            <div><span>{topic.data.eyebrow}</span><h3>{topic.data.heading}</h3><p>{topic.data.description}</p><ArrowRight size={19} aria-hidden="true" /></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section popular-questions">
    <div class="shell two-column-heading">
      <div><p class="eyebrow">Popular questions</p><h2>Direct answers to common flower questions</h2><p>Each answer is brief. Related guides carry the fuller context.</p></div>
      <div class="question-list">
        {faqs.slice(0, 6).map((faq) => <a href={`/faq/${faq.data.slug}/`}>{faq.data.question}<ArrowRight size={18} aria-hidden="true" /></a>)}
        <a class="all-questions" href="/faq/">See all questions <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="section editorial-band">
    <div class="shell editorial-layout">
      <div><p class="eyebrow">A better buying decision</p><h2>The right flowers depend on more than appearance</h2></div>
      <div><p>Meaning, freshness, care, fragrance, pets, venue rules, delivery timing, and the recipient all shape whether a bouquet works. Our guides help you ask better questions before following a commercial recommendation.</p><a class="text-link" href="/guides/choosing-flowers/">Read the choosing guide <ArrowRight size={17} aria-hidden="true" /></a></div>
    </div>
  </section>
</BaseLayout>
