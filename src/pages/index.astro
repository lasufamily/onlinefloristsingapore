---
import { ArrowRight, CalendarCheck, Flower2, Send } from '@lucide/astro';
import { getCollection } from 'astro:content';
import EnquirySection from '../components/EnquirySection.astro';
import ProductCard from '../components/ProductCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { canonicalPages } from '../lib/site-pages';

const categories = await getCollection('categories');
const products = await getCollection('products');
const categoryById = new Map(categories.map((category) => [category.id, category]));
const home = canonicalPages.find((page) => page.path === '/')!;
const featuredCategoryIds = ['birthday', 'funeral', 'opening', 'preserved', 'newborn', 'graduation', 'roses', 'corporate'];
const featuredCategories = featuredCategoryIds.map((id) => categoryById.get(id)).filter(Boolean);
const featuredProducts = products.slice(0, 6);
---

<BaseLayout title={home.title} description={home.description} canonicalPath="/">
  <section class="hero">
    <img src="/images/hero-flowers.jpg" alt="Florist arranging a vivid seasonal bouquet in a bright Singapore studio" width="1920" height="1280" fetchpriority="high" />
    <div class="hero-content shell">
      <p class="eyebrow">Stem & Story · Singapore</p>
      <h1>Made-to-order flowers in Singapore</h1>
      <p>Begin with the person, the occasion, and the date. We will shape a floral direction and confirm what is genuinely available.</p>
      <div class="hero-actions">
        <a class="button light" href="#enquire">Start an enquiry <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="button secondary" style="color:white;border-color:white" href="#browse">Browse flowers</a>
      </div>
    </div>
  </section>

  <div class="trust-strip" aria-label="How enquiries work">
    <div class="trust-item"><Flower2 size={23} aria-hidden="true" /><div><strong>Original arrangements</strong><span>Every direction is adapted to the brief and available stems.</span></div></div>
    <div class="trust-item"><CalendarCheck size={23} aria-hidden="true" /><div><strong>Timing confirmed first</strong><span>No delivery promise is made before the studio checks the date.</span></div></div>
    <div class="trust-item"><Send size={23} aria-hidden="true" /><div><strong>One structured enquiry</strong><span>Keep the palette, recipient, budget, and logistics together.</span></div></div>
  </div>

  <section class="section" id="browse">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Browse by reason</p><h2>The occasion changes the flowers</h2></div>
        <p>A condolence stand, birthday bouquet, and reception arrangement each have different work to do. Start in the right room.</p>
      </div>
      <div class="category-grid">
        {featuredCategories.map((category) => category && (
          <a class="category-card" href={category.data.path}>
            <img src={category.data.image} alt={category.data.imageAlt} width="900" height="1100" loading="lazy" />
            <div class="copy"><span>{category.data.eyebrow}</span><h3>{category.data.name}</h3></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--soft)">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">Studio directions</p><h2>A starting point, not a stock photograph</h2></div>
        <p>Use these concepts to communicate shape, colour, and mood. The final stem list follows availability and your brief.</p>
      </div>
      <div class="product-grid">
        {featuredProducts.map((product) => (
          <ProductCard {...product.data} categoryName={categoryById.get(product.data.category)?.data.name ?? 'Flowers'} />
        ))}
      </div>
    </div>
  </section>

  <section class="section process-band">
    <div class="shell">
      <p class="eyebrow" style="color:#f8dc7c">From brief to flowers</p>
      <h2>Clear details make better arrangements</h2>
      <div class="steps">
        <div><div class="step-number">1</div><h3>Send the essentials</h3><p>Occasion, date, destination, budget, palette, and anything the flowers need to say.</p></div>
        <div><div class="step-number">2</div><h3>Receive a confirmed direction</h3><p>The studio checks timing and materials before suggesting scope and next steps.</p></div>
        <div><div class="step-number">3</div><h3>Approve before arranging</h3><p>No assumption becomes an order until the arrangement and logistics are agreed.</p></div>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell faq-layout">
      <div><p class="eyebrow">A clearer first step</p><h2>Before an enquiry becomes an order</h2></div>
      <div class="faq-list">
        <details><summary>Are these products ready to buy?</summary><p>No. They are creative starting points. The studio confirms the design, flower availability, price, timing, and delivery details before accepting an order.</p></details>
        <details><summary>Can I request delivery anywhere in Singapore?</summary><p>Send the six-digit postal code with your preferred date. Coverage, access, timing, and any delivery charge are confirmed individually.</p></details>
        <details><summary>What happens after I submit?</summary><p>Your brief is reviewed against the date and available materials. A reply will confirm what is possible and the next step; submitting the form does not create an order.</p></details>
      </div>
    </div>
  </section>

  <EnquirySection />
</BaseLayout>
