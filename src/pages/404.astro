---
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Hyper Florist" description="The requested page could not be found." canonicalPath="/404/" noindex>
  <section class="section"><div class="shell" style="max-width:760px;text-align:center;padding-block:80px">
    <h1 style="font-size:clamp(42px,7vw,72px)">This flower page could not be found</h1>
    <p style="color:var(--muted);margin:24px auto;max-width:560px">Head back home to browse flower guides, occasions, recipients, gifts, plants, and common questions.</p>
    <a class="button" href="/"><ArrowLeft size={18} aria-hidden="true" /> Return home</a>
  </div></section>
</BaseLayout>
