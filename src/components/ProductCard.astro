---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  name: string;
  summary: string;
  image: string;
  imageAlt: string;
  palette: string;
  availabilityNote: string;
  categoryName: string;
}

const { name, summary, image, imageAlt, palette, availabilityNote, categoryName } = Astro.props;
const href = `/contact/?product=${encodeURIComponent(name)}&occasion=${encodeURIComponent(categoryName)}`;
---

<article class="product-card">
  <div class="media">
    <img src={image} alt={imageAlt} width="800" height="1000" loading="lazy" />
    <span class="tag">{palette}</span>
  </div>
  <div class="body">
    <h3>{name}</h3>
    <p>{summary}</p>
    <a class="text-link" href={href} aria-label={`Enquire about ${name}`}>
      Enquire <ArrowUpRight size={17} aria-hidden="true" />
    </a>
    <span class="sr-note">{availabilityNote}</span>
  </div>
</article>

<style>.sr-note{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}</style>
