---
import { ArrowRight, BookOpen, ChevronRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import AffiliateLink from './AffiliateLink.astro';

interface Props {
  page: CollectionEntry<'knowledgePages'>;
  allPages: CollectionEntry<'knowledgePages'>[];
  faqs: CollectionEntry<'faq'>[];
  affiliate?: {
    href: string;
    anchor: string;
    disclosure: string;
  };
}

const { page, allPages, faqs, affiliate } = Astro.props;
const byPath = new Map(allPages.map((entry) => [entry.data.path, entry]));
const children = allPages
  .filter((entry) => entry.data.parent === page.data.path)
  .sort((a, b) => a.data.heading.localeCompare(b.data.heading));
const related = page.data.relatedPages
  .map((path) => byPath.get(path))
  .filter((entry): entry is CollectionEntry<'knowledgePages'> => Boolean(entry));
const relatedFaqs = faqs
  .filter((entry) => entry.data.relatedPages.includes(page.data.path))
  .sort((a, b) => a.data.priority - b.data.priority);
const topic = page.data.heading.toLowerCase();
const root = page.data.path.split('/').filter(Boolean)[0] ?? 'flowers';
const categoryFocus: Record<string, string> = {
  flowers: 'freshness, scent, colour, vase life, care needs, and whether the flowers suit the recipient',
  occasions: 'the tone of the occasion, your relationship with the recipient, the venue, and the message on the card',
  'flowers-for': 'the recipient’s preferences, the relationship, allergies or pets, and how formal the gesture should feel',
  'bouquets-and-arrangements': 'the display space, arrangement size, water source, viewing angle, and how the flowers will be carried or installed',
  gifts: 'the recipient’s preferences, dietary or household restrictions, storage, presentation, and the timing of the handover',
  plants: 'available light, watering habits, ventilation, pets, pot drainage, and the amount of care the recipient can provide',
  guides: 'the decision you need to make, the information still missing, your practical constraints, and the questions a florist should answer',
  'flower-culture': 'the local context, cultural meaning, setting, audience, and whether a claim is historical, symbolic, or practical',
};
const practicalGuidance = [
  {
    heading: 'Define the purpose first',
    body: `When considering ${topic}, decide what the flowers, plant, or gift needs to communicate. Consider ${categoryFocus[root] ?? categoryFocus.flowers}. A clear purpose makes it easier to compare options without being distracted by styling alone.`,
  },
  {
    heading: 'Plan for the Singapore setting',
    body: 'Think through where and when the flowers, plant, arrangement, or gift will be received. Heat, humidity, travel time, air-conditioning, venue access, and the time before display can affect what remains presentable. Share those conditions before the final design or delivery method is confirmed.',
  },
  {
    heading: 'Confirm the order details',
    body: `Ask for the final dimensions, flower or product substitutions, packaging, care instructions, delivery window, and the wording on the card. Check names, contact details, postal code, unit number, and access instructions before payment so avoidable corrections do not delay the handover.`,
  },
];

const ancestors: CollectionEntry<'knowledgePages'>[] = [];
let parentPath = page.data.parent;
while (parentPath && parentPath !== '/') {
  const parent = byPath.get(parentPath);
  if (!parent) break;
  ancestors.unshift(parent);
  parentPath = parent.data.parent;
}
---

<nav class="breadcrumbs shell" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <ChevronRight size={14} aria-hidden="true" />
  {ancestors.map((ancestor) => (
    <><a href={ancestor.data.path}>{ancestor.data.heading}</a><ChevronRight size={14} aria-hidden="true" /></>
  ))}
  <span aria-current="page">{page.data.heading}</span>
</nav>

<article>
  <header class="knowledge-hero">
    <div class="knowledge-hero-copy">
      <h1>{page.data.heading}</h1>
      <p>{page.data.intro}</p>
    </div>
    <div class="knowledge-hero-media">
      <img src={page.data.image} alt={page.data.imageAlt} width="1200" height="900" />
    </div>
  </header>

  {children.length > 0 && (
    <section class="section topic-directory">
      <div class="shell">
        <div class="section-head compact-head">
          <div><h2>Choose a place to begin</h2></div>
          <p>Follow the subject from broad guidance into the flower, recipient, arrangement, or decision you are researching.</p>
        </div>
        <div class="link-card-grid">
          {children.map((child) => (
            <a class="link-card" href={child.data.path}>
              <h3>{child.data.heading}</h3>
              <p>{child.data.description}</p>
              <ArrowRight size={19} aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section article-band">
    <div class="article-layout shell">
      <BookOpen class="article-icon" size={24} aria-hidden="true" />
      <div class="article-copy">
        {page.data.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </section>
        ))}
        {affiliate && <AffiliateLink href={affiliate.href} anchor={affiliate.anchor} disclosure={affiliate.disclosure} />}
      </div>
    </div>
  </section>

  <section class="section practical-section">
    <div class="shell">
      <h2>A practical checklist for {page.data.heading}</h2>
      <div class="guidance-grid">
        {practicalGuidance.map((item) => (
          <section>
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  {relatedFaqs.length > 0 && (
    <section class="section question-links">
      <div class="shell two-column-heading">
        <div><h2>Related questions</h2></div>
        <div class="question-list">
          {relatedFaqs.map((faq) => <a href={`/faq/${faq.data.slug}/`}>{faq.data.question}<ArrowRight size={18} aria-hidden="true" /></a>)}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section related-band">
      <div class="shell">
        <h2>Related reading</h2>
        <div class="related-links">
          {related.map((entry) => (
            <a href={entry.data.path}>
              <h3>{entry.data.heading}</h3>
              <p>{entry.data.description}</p>
              <ArrowRight size={17} aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</article>
