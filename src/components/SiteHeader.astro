---
import { Menu, X } from '@lucide/astro';

const primary = [
  ['Flowers', '/flowers/'],
  ['Occasions', '/occasions/'],
  ['Flowers For', '/flowers-for/'],
  ['Arrangements', '/bouquets-and-arrangements/'],
  ['Gifts', '/gifts/'],
  ['Plants', '/plants/'],
];
const secondary = [['Guides', '/guides/'], ['Flower Culture', '/flower-culture/'], ['FAQ', '/faq/']];
---

<div class="notice-band">Local flower guides for clearer gifting decisions.</div>
<header class="site-header">
  <div class="inner shell">
    <a class="brand" href="/" aria-label="Online Florist Singapore home">
      <strong>Online Florist Singapore</strong>
      <span>Singapore flower guides</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {primary.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary class="icon-button" aria-label="Open navigation">
        <Menu class="menu-open-icon" size={24} aria-hidden="true" />
        <X class="menu-close-icon" size={24} aria-hidden="true" />
      </summary>
      <nav class="mobile-panel" aria-label="Mobile navigation">
        {[...primary, ...secondary].map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    </details>
  </div>
  <nav class="secondary-nav shell" aria-label="Secondary navigation">
    {secondary.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
</header>

<style>
  .menu-close-icon { display: none; }
  details[open] .menu-open-icon { display: none; }
  details[open] .menu-close-icon { display: block; }
</style>
