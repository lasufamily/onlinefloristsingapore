<form class="enquiry-form" id="contact-form" action="https://submit-form.com/6Aa3k1TjD" method="POST">
  <div class="form-grid">
    <div class="field">
      <label for="name">Name <span class="required-marker" aria-hidden="true">*</span></label>
      <input id="name" name="name" autocomplete="name" required maxlength="80" />
    </div>
    <div class="field">
      <label for="phone">Phone <span class="required-marker" aria-hidden="true">*</span></label>
      <input
        id="phone"
        name="phone"
        autocomplete="tel"
        inputmode="numeric"
        pattern="[0-9]{8}"
        minlength="8"
        maxlength="8"
        title="Enter an 8-digit Singapore phone number"
        required
      />
    </div>
    <div class="field">
      <label for="email">Email <span class="required-marker" aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
    </div>
    <div class="field full">
      <label for="message">Message <span class="required-marker" aria-hidden="true">*</span></label>
      <textarea id="message" name="message" maxlength="2000" required placeholder="How can we help?"></textarea>
    </div>
  </div>
  <div class="form-actions">
    <button class="button" type="submit">Send message</button>
  </div>
</form>
