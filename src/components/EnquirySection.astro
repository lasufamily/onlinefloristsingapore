---
import { CalendarDays, MapPin, MessageSquareText } from '@lucide/astro';
import EnquiryForm from './EnquiryForm.astro';
---

<section class="section enquiry-band" id="enquire">
  <div class="shell enquiry-layout">
    <div class="enquiry-intro">
      <p class="eyebrow">Start with the details</p>
      <h2>Tell us what you are trying to send</h2>
      <p>Share the occasion, date, delivery area, and budget. We will use those details to understand what kind of flower help you need.</p>
      <div class="trust-item"><CalendarDays size={22} aria-hidden="true" /><div><strong>Date first</strong><span>Timing affects what is fresh and practical.</span></div></div>
      <div class="trust-item"><MapPin size={22} aria-hidden="true" /><div><strong>Location matters</strong><span>Postal code, venue rules, and access can change the plan.</span></div></div>
      <div class="trust-item"><MessageSquareText size={22} aria-hidden="true" /><div><strong>Clear message</strong><span>Put the flowers, card note, and delivery details in one place.</span></div></div>
    </div>
    <EnquiryForm />
  </div>
</section>
