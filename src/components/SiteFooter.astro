---
import { brand } from '../lib/brand';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid knowledge-footer">
      <div>
        <img
          class="footer-logo"
          src="/images/brand/hyper-florist-logo-white.png"
          alt="Hyper Florist logo"
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>
      <nav aria-label="About this site">
        <strong>About</strong>
        <a href="/about/">About Us</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
      </nav>
      <nav aria-label="Learn about flowers">
        <strong>Learn</strong>
        <a href="/flowers/">Flowers</a>
        <a href="/bouquets-and-arrangements/">Arrangements</a>
        <a href="/plants/">Plants</a>
        <a href="/guides/">Guides</a>
        <a href="/faq/">FAQ</a>
      </nav>
      <nav aria-label="Gifting guides">
        <strong>Gifting</strong>
        <a href="/occasions/">Occasions</a>
        <a href="/flowers-for/">Flowers For</a>
        <a href="/gift-ideas/">Gift Ideas</a>
        <a href="/hampers/">Hampers</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {brand.name}</span>
      <span>Flower availability, substitutions, and delivery terms depend on the florist.</span>
    </div>
  </div>
</footer>
